# Normalise line endings in the repository; check out with the platform default.
* text=auto eol=lf

# Scripts must keep the line endings their shells expect.
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files: never diff or convert.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Keep generated lockfiles out of diffs and language statistics.
frontend/package-lock.json linguist-generated=true -diff

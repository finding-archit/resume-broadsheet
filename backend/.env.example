# Environment variables read by app/config.py. Set them in the shell (or your process
# manager) before starting uvicorn. All are optional; no secrets or API keys are needed.

# Weights of the overall score. They are normalised to sum to 1, so 3 and 2
# behave like 0.6 and 0.4. Defaults: 0.60 and 0.40.
TFIDF_WEIGHT=0.60
SKILL_WEIGHT=0.40

# Maximum resume upload size in megabytes (default 5). Requests to /api/analyze
# larger than this plus 1 MB of form overhead are rejected with HTTP 413.
MAX_FILE_SIZE_MB=5

# Comma-separated list of origins allowed by CORS (default: the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
